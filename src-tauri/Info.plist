<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- CloudUp serves mounted drives from the background; App Nap would
       throttle it while the window is hidden and stall Finder. -->
  <key>NSAppSleepDisabled</key>
  <true/>
  <!-- Only standard encryption (HTTPS/TLS, SSH, HMAC request signing), which
       is exempt; confirm in App Store Connect's export compliance questions. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>CloudUp saves the files you download from your cloud storage, for example a PDF from your S3 bucket, to your Downloads folder.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>CloudUp connects to storage on your local network that you add, for example a NAS reached over WebDAV, FTP or SFTP.</string>
</dict>
</plist>
