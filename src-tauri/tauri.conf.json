{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudUp",
  "version": "1.1.3",
  "identifier": "net.cloudup.desktop",
  "build": {
    "beforeDevCommand": "npm run serve",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "",
    "frontendDist": "../src",
    "beforeBundleCommand": "sh scripts/build-fileprovider.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Connections",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application",
      "entitlements": "entitlements.plist",
      "files": {
        "PlugIns/CloudUpFiles.appex": "target/fileprovider/CloudUpFiles.appex"
      },
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mount cloud storage as a local drive",
    "longDescription": "CloudUp lets you connect to S3, WebDAV and other cloud storage and mount it as a drive in Finder or Explorer.",
    "createUpdaterArtifacts": true,
    "copyright": "\u00a9 2026 demelos LLC",
    "publisher": "demelos LLC"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDM0ZERjIwQTY5NjI2MDUKUldRRkpwYW1JTjgvTFBtai9EaUJEaDlGc1Q1SDhwekRiRnp1QkpkOE81a0V0NzJKVDhEbUtpMHEK",
      "endpoints": [
        "https://www.demelos.com/tools/cloudup/latest.json"
      ]
    }
  }
}
